---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Хлібні крихти" class="no-print mb-4 font-sans text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    <li><a href="/" class="hover:text-brand">Головна</a></li>
    {items.map((it) => (
      <>
        <li aria-hidden="true" class="opacity-50">/</li>
        <li>{it.href ? <a href={it.href} class="hover:text-brand">{it.label}</a> : <span class="text-heading">{it.label}</span>}</li>
      </>
    ))}
  </ol>
</nav>
