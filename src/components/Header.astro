---
import { SITE, CLASSES } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="no-print sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
    <a href="/" class="flex items-center gap-2 font-sans text-lg font-extrabold tracking-tight text-heading">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand font-serif text-base text-white">Л</span>
      <span class="hidden sm:inline">Література</span>
    </a>

    <nav class="no-scrollbar -mx-1 flex flex-1 items-center gap-1 overflow-x-auto px-1 font-sans text-sm">
      {
        CLASSES.map((k) => (
          <a
            href={`/${k}-klas/`}
            class:list={[
              'shrink-0 rounded-lg px-2.5 py-1.5 font-medium transition',
              isActive(`/${k}-klas`) ? 'bg-brand text-white' : 'text-muted hover:bg-surface hover:text-heading',
            ]}
          >
            {k}
          </a>
        ))
      }
      <span class="mx-1 h-5 w-px shrink-0 bg-line"></span>
      <a href="/pysmennyky/" class:list={['shrink-0 rounded-lg px-2.5 py-1.5 font-medium transition', isActive('/pysmennyky') ? 'bg-brand text-white' : 'text-muted hover:text-heading']}>Письменники</a>
      <a href="/tvir-na-temu/" class:list={['shrink-0 rounded-lg px-2.5 py-1.5 font-medium transition', isActive('/tvir-na-temu') ? 'bg-brand text-white' : 'text-muted hover:text-heading']}>Твори</a>
      <a href="/napamyat/" class:list={['hidden shrink-0 rounded-lg px-2.5 py-1.5 font-medium transition md:block', isActive('/napamyat') ? 'bg-brand text-white' : 'text-muted hover:text-heading']}>Напам’ять</a>
      <a href="/nmt/" class:list={['shrink-0 rounded-lg px-2.5 py-1.5 font-bold transition', isActive('/nmt') ? 'bg-brand text-white' : 'text-brand hover:bg-brand/10']}>НМТ</a>
    </nav>

    <a href="/poshuk/" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-line text-muted transition hover:text-brand" aria-label="Пошук">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    </a>
    <ThemeToggle />
  </div>
</header>
