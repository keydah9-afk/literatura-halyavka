---
// «Паспорт твору» — те, що вчитель питає першим і що найчастіше йде в зошит.
interface Props {
  passport: {
    genre: string; year?: string; direction?: string; theme: string; idea: string;
    composition?: string; conflict?: string; narrator?: string; setting?: string;
  };
  author?: string;
}
const { passport: p, author } = Astro.props;
const rows: [string, string | undefined][] = [
  ['Автор', author],
  ['Рік', p.year],
  ['Жанр', p.genre],
  ['Літературний напрям', p.direction],
  ['Тема', p.theme],
  ['Ідея', p.idea],
  ['Композиція', p.composition],
  ['Конфлікт', p.conflict],
  ['Оповідач', p.narrator],
  ['Місце і час дії', p.setting],
];
---
<section id="pasport" class="my-6 overflow-hidden rounded-xl border border-line bg-surface">
  <h2 class="border-b border-line px-4 py-3 font-sans text-base font-bold text-heading">Паспорт твору</h2>
  <dl class="divide-y divide-line">
    {rows.filter(([, v]) => v).map(([k, v]) => (
      <div class="grid gap-1 px-4 py-2.5 sm:grid-cols-[11rem_1fr] sm:gap-4">
        <dt class="font-sans text-xs font-semibold uppercase tracking-wide text-muted sm:text-[0.8rem] sm:normal-case sm:tracking-normal">{k}</dt>
        <dd class="text-[0.98rem] leading-relaxed">{v}</dd>
      </div>
    ))}
  </dl>
</section>
