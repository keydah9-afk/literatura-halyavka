---
interface Props {
  quiz: { q: string; options: string[]; answer: number; explain?: string }[];
}
const { quiz } = Astro.props;
---
<section id="test" class="no-print">
  <h2 class="mb-1 font-sans text-2xl font-bold text-heading">Перевір себе</h2>
  <p class="mb-4 font-sans text-sm text-muted">{quiz.length} питань. Відповіді перевіряються одразу — нічого нікуди не надсилається.</p>

  <div class="space-y-3" data-quiz>
    {quiz.map((item, qi) => (
      <article class="rounded-xl border border-line bg-surface p-4" data-question data-answer={item.answer}>
        <p class="mb-3 font-sans text-[0.98rem] font-semibold text-heading">{qi + 1}. {item.q}</p>
        <div class="space-y-1.5">
          {item.options.map((opt, oi) => (
            <button type="button" data-option={oi}
              class="block w-full rounded-lg border border-line px-3 py-2 text-left text-[0.95rem] transition hover:border-brand/60">
              {opt}
            </button>
          ))}
        </div>
        {item.explain && <p class="mt-3 hidden rounded-lg bg-cream px-3 py-2 font-sans text-sm text-body" data-explain>{item.explain}</p>}
      </article>
    ))}
  </div>
  <p class="mt-4 font-sans text-sm font-semibold text-heading" data-score hidden></p>
</section>

<script>
  function initQuiz() {
    document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
      if (quiz.dataset.bound) return;
      quiz.dataset.bound = '1';
      const questions = [...quiz.querySelectorAll<HTMLElement>('[data-question]')];
      const scoreEl = quiz.parentElement?.querySelector<HTMLElement>('[data-score]');
      let correct = 0;
      let answered = 0;

      questions.forEach((q) => {
        const right = Number(q.dataset.answer);
        const buttons = [...q.querySelectorAll<HTMLButtonElement>('[data-option]')];
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            if (q.dataset.done) return;
            q.dataset.done = '1';
            answered += 1;
            const picked = Number(btn.dataset.option);
            if (picked === right) correct += 1;
            buttons.forEach((b, i) => {
              b.disabled = true;
              if (i === right) b.classList.add('border-emerald-500', 'bg-emerald-500/10');
              else if (i === picked) b.classList.add('border-red-500', 'bg-red-500/10');
              else b.classList.add('opacity-60');
            });
            q.querySelector<HTMLElement>('[data-explain]')?.classList.remove('hidden');
            if (scoreEl) {
              scoreEl.hidden = false;
              scoreEl.textContent = `Правильних: ${correct} з ${answered}` + (answered === questions.length ? ` — тест завершено.` : '');
            }
          });
        });
      });
    });
  }
  initQuiz();
  document.addEventListener('astro:page-load', initQuiz);
</script>
