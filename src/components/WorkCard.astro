---
interface Props {
  work: { slug: string; title: string; author?: string; genre: string; byHeart?: boolean };
  /** Чи є вже сторінка з контентом */
  ready: boolean;
}
const { work, ready } = Astro.props;
---
{ready ? (
  <a href={`/tvory/${work.slug}/`} class="group flex items-baseline justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3 transition hover:border-brand/60">
    <span>
      <span class="font-sans text-[0.98rem] font-semibold text-heading group-hover:text-brand">{work.title}</span>
      {work.author && <span class="ml-2 font-sans text-sm text-muted">{work.author}</span>}
      <span class="mt-0.5 block font-sans text-xs text-muted">{work.genre}{work.byHeart ? ' · напам’ять' : ''}</span>
    </span>
    <svg class="mt-1 h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6" /></svg>
  </a>
) : (
  <div class="flex items-baseline justify-between gap-3 rounded-lg border border-dashed border-line px-4 py-3 opacity-70">
    <span>
      <span class="font-sans text-[0.98rem] font-semibold text-muted">{work.title}</span>
      {work.author && <span class="ml-2 font-sans text-sm text-muted">{work.author}</span>}
      <span class="mt-0.5 block font-sans text-xs text-muted">{work.genre}{work.byHeart ? ' · напам’ять' : ''}</span>
    </span>
    <span class="shrink-0 rounded-md bg-line/60 px-2 py-0.5 font-sans text-[0.7rem] text-muted">готуємо</span>
  </div>
)}
