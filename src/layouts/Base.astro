---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '@fontsource-variable/inter';
import '@fontsource/lora/400.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/lora/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description = SITE.description, type, noindex, jsonLd } = Astro.props;
---

<html lang={SITE.lang} class="h-full">
  <head>
    <BaseHead {title} {description} {type} {noindex} {jsonLd} />
  </head>
  <body class="flex min-h-full flex-col font-sans antialiased">
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
