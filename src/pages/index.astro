---
import Base from '../layouts/Base.astro';
import { PROGRAM, BY_HEART } from '../data/program';
import { getWorks, getEssays, getAuthors, plural } from '../lib/content';
import { SITE, CLASSES } from '../data/site';
import { NMT_REAL_WORKS } from '../data/nmt';

const works = await getWorks();
const essays = await getEssays();
const authors = await getAuthors();
const totalProgram = PROGRAM.reduce((n, c) => n + c.sections.reduce((m, s) => m + s.works.length, 0), 0);
const newest = <T extends { data: { date: Date; updatedDate?: Date; title: string } }>(a: T, b: T) =>
  +(b.data.updatedDate ?? b.data.date) - +(a.data.updatedDate ?? a.data.date) || a.data.title.localeCompare(b.data.title, 'uk');
const latest = [...works].sort(newest).slice(0, 8);

const classCards = CLASSES.map((k) => ({
  klas: k,
  tagline: PROGRAM.find((c) => c.klas === k)?.tagline,
  works: works.filter((w) => w.data.classes.includes(k)).length,
  essays: essays.filter((e) => e.data.classes.includes(k)).length,
}));

// По одній темі на клас, від старших до молодших: на головній мають бути всі вікові групи
const essayPicks = [...CLASSES].reverse().flatMap((k) =>
  [...essays].sort(newest).filter((e) => e.data.classes.includes(k)).slice(0, k >= 9 ? 2 : 1),
).filter((e, i, arr) => arr.findIndex((x) => x.id === e.id) === i).slice(0, 10);

const workIds = new Set(works.map((w) => w.id));
const byHeartPicks = CLASSES.flatMap((k) => BY_HEART.filter((w) => w.klas === k && workIds.has(w.slug)).slice(0, 1)).slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'uk',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/poshuk/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base title={SITE.title} description={SITE.description} {jsonLd}>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center">
      <h1 class="font-sans text-4xl font-extrabold leading-tight tracking-tight text-heading sm:text-5xl">
        Українська література<br class="hidden sm:block" /> без паніки перед уроком
      </h1>
      <p class="mx-auto mt-4 max-w-reading font-serif text-lg leading-relaxed text-muted">
        Короткий зміст, паспорт твору, характеристики героїв, цитати і готові шкільні твори —
        для 5–11 класів. Без реклами, спливаючих вікон і «зареєструйтесь, щоб прочитати».
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-2">
        <a href="/tvory/" class="rounded-xl bg-brand px-5 py-2.5 font-sans text-sm font-semibold text-white transition hover:opacity-90">Усі розбори творів</a>
        <a href="/poshuk/" class="rounded-xl border border-line bg-paper px-5 py-2.5 font-sans text-sm font-semibold text-heading transition hover:border-brand hover:text-brand">Знайти твір або автора</a>
      </div>
      <p class="mt-6 font-sans text-sm text-muted">
        {totalProgram} творів у каталозі програми · {works.length} {plural(works.length, ['розбір', 'розбори', 'розборів'])} готово · {essays.length} {plural(essays.length, ['тема', 'теми', 'тем'])} для творів
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-12">
    <h2 class="font-sans text-2xl font-bold text-heading">Обери клас</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {classCards.map((c) => (
        <a href={`/${c.klas}-klas/`} class="group rounded-xl border border-line bg-surface p-4 transition hover:border-brand/60">
          <p class="font-sans text-lg font-bold text-heading group-hover:text-brand">{c.klas} клас</p>
          {c.tagline && <p class="mt-0.5 font-sans text-sm text-muted">{c.tagline}</p>}
          <p class="mt-2 font-sans text-xs text-muted">
            {c.works} {plural(c.works, ['розбір', 'розбори', 'розборів'])}{c.essays > 0 && <> · {c.essays} {plural(c.essays, ['тема', 'теми', 'тем'])} творів</>}
          </p>
        </a>
      ))}
      <a href="/tvory/" class="group flex flex-col justify-center rounded-xl border border-dashed border-brand/40 p-4 transition hover:border-brand">
        <p class="font-sans text-lg font-bold text-brand">Усі розбори →</p>
        <p class="mt-0.5 font-sans text-sm text-muted">{works.length} творів, фільтр за класом і НМТ</p>
      </a>
    </div>

    <section class="mt-12 rounded-2xl border border-brand/30 bg-cream p-5 sm:p-6">
      <p class="font-sans text-xs font-bold uppercase tracking-wide text-brand">10–11 клас</p>
      <h2 class="mt-1 font-sans text-2xl font-bold text-heading">Готуєшся до НМТ?</h2>
      <p class="mt-2 max-w-reading text-[0.98rem] leading-relaxed">
        Українська література — предмет на вибір, і список творів для нього менший за шкільну
        програму: {NMT_REAL_WORKS.length} текстів, які відомі заздалегідь. Ми зібрали їх усі —
        з героями, крилатими рядками й тренажером, де питання генеруються щоразу нові.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/nmt/" class="rounded-lg bg-brand px-4 py-2 font-sans text-sm font-semibold text-white transition hover:opacity-90">Розділ НМТ</a>
        <a href="/nmt/trenazher/" class="rounded-lg border border-brand/40 px-4 py-2 font-sans text-sm font-semibold text-brand transition hover:bg-brand/10">Тренажер</a>
        <a href="/nmt/tvory/" class="rounded-lg border border-line px-4 py-2 font-sans text-sm font-semibold text-heading transition hover:border-brand hover:text-brand">Усі твори НМТ</a>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="font-sans text-2xl font-bold text-heading">Нове на сайті</h2>
        <a href="/tvory/" class="shrink-0 font-sans text-sm font-semibold text-brand hover:underline">Усі {works.length} →</a>
      </div>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {latest.map((w) => (
          <li>
            <a href={`/tvory/${w.id}/`} class="group block h-full rounded-lg border border-line bg-surface px-4 py-3 transition hover:border-brand/60">
              <span class="font-sans text-[0.98rem] font-semibold text-heading group-hover:text-brand">{w.data.title}</span>
              {w.data.author && <span class="ml-2 font-sans text-sm text-muted">{w.data.author}</span>}
              <span class="mt-0.5 line-clamp-1 font-sans text-xs text-muted">{w.data.passport.genre} · {w.data.classes.join(', ')} клас</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {essayPicks.length > 0 && (
      <section class="mt-12">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="font-sans text-2xl font-bold text-heading">Твір на тему</h2>
          <a href="/tvir-na-temu/" class="shrink-0 font-sans text-sm font-semibold text-brand hover:underline">Усі {essays.length} тем →</a>
        </div>
        <p class="mt-1 max-w-reading text-[0.95rem] text-muted">План, цитати й {SITE.essayVariants} різні варіанти на тему — щоб написати своє, а не переписати чуже.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {essayPicks.map((e) => (
            <li>
              <a href={`/tvir-na-temu/${e.id}/`} class="group block h-full rounded-lg border border-line bg-surface px-4 py-3 transition hover:border-brand/60">
                <span class="font-sans text-[0.98rem] font-semibold text-heading group-hover:text-brand">{e.data.title}</span>
                <span class="mt-0.5 block font-sans text-xs text-muted">{e.data.workTitle} · {e.data.classes.join(', ')} клас</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {byHeartPicks.length > 0 && (
      <section class="mt-12">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="font-sans text-2xl font-bold text-heading">Вивчити напам’ять</h2>
          <a href="/napamyat/" class="shrink-0 font-sans text-sm font-semibold text-brand hover:underline">Увесь список →</a>
        </div>
        <p class="mt-1 max-w-reading text-[0.95rem] text-muted">На сторінці вірша є режим «вчу напам’ять»: рядки ховаються, лишається перший у строфі.</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {byHeartPicks.map((w) => (
            <li>
              <a href={`/tvory/${w.slug}/`} class="inline-block rounded-lg border border-line bg-surface px-3 py-2 font-sans text-sm text-heading transition hover:border-brand hover:text-brand">
                {w.title} <span class="text-muted">· {w.klas} кл.</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12">
      <h2 class="font-sans text-2xl font-bold text-heading">Що тут є</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {[
          ['📖', 'Короткий зміст', 'Три рівні: сюжет у трьох реченнях, стислий переказ і докладний — по розділах.', '/tvory/'],
          ['🧭', 'Паспорт твору', 'Жанр, тема, ідея, композиція, конфлікт — усе, що диктують у зошит.', '/tvory/'],
          ['👤', 'Герої та цитати', 'Характеристики з рисами характеру і цитатами, які можна вставити у відповідь.', '/tvory/'],
          ['✍️', 'Готові твори', `На кожну тему — ${SITE.essayVariants} варіанти різного обсягу, з планом і цитатами.`, '/tvir-na-temu/'],
          ['🎓', 'Біографії письменників', 'Коротко, з хронологією і фактами, які просять розказати на уроці.', '/pysmennyky/'],
          ['🧠', 'Напам’ять і теорія', 'Список творів напам’ять і словник літературознавчих термінів.', '/napamyat/'],
        ].map(([icon, t, text, href]) => (
          <a href={href} class="group rounded-xl border border-line bg-surface p-4 transition hover:border-brand/60">
            <p class="mb-1 font-sans text-[0.98rem] font-bold text-heading group-hover:text-brand"><span class="mr-2">{icon}</span>{t}</p>
            <p class="text-[0.95rem] leading-relaxed text-muted">{text}</p>
          </a>
        ))}
      </div>
    </section>

    {authors.length > 0 && (
      <section class="mt-12">
        <h2 class="font-sans text-2xl font-bold text-heading">Письменники</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {authors.map((a) => (
            <li>
              <a href={`/pysmennyky/${a.id}/`} class="inline-block rounded-lg border border-line bg-surface px-3 py-2 font-sans text-sm text-heading transition hover:border-brand hover:text-brand">
                {a.data.title} <span class="text-muted">{a.data.years}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
