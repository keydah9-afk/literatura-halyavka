---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import QuoteList from '../../components/QuoteList.astro';
import Tag from '../../components/Tag.astro';
import { getAuthors, getWorks } from '../../lib/content';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props;
const d = author.data;
const { Content } = await render(author);
const works = (await getWorks()).filter((w) => w.data.authorSlug === author.id);

const title = `${d.title} (${d.years}) — біографія коротко`;
const description = d.description ?? `${d.title} — ${d.role}. Коротка біографія, хронологія життя, цікаві факти та список творів шкільної програми.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.title,
  description: d.role,
  birthPlace: d.birthPlace,
};
---

<Base {title} {description} type="article" {jsonLd}>
  <div class="mx-auto max-w-reading px-4 py-8">
    <Breadcrumbs items={[{ label: 'Письменники', href: '/pysmennyky/' }, { label: d.title }]} />

    <h1 class="font-sans text-3xl font-extrabold leading-tight tracking-tight text-heading sm:text-4xl">{d.title}</h1>
    <p class="mt-1.5 font-sans text-base text-muted">{d.years} · {d.role}</p>
    {d.classes.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {d.classes.map((k) => <Tag tone="ink" href={`/${k}-klas/`}>{k} клас</Tag>)}
      </div>
    )}

    {d.facts.length > 0 && (
      <Callout tone="key" title="Головне за хвилину" icon="⚡">
        <ul class="ml-4 list-disc space-y-1.5">{d.facts.map((f) => <li>{f}</li>)}</ul>
      </Callout>
    )}

    <div class="prose-reading my-6"><Content /></div>

    {d.timeline.length > 0 && (
      <section class="my-8">
        <h2 class="mb-3 font-sans text-2xl font-bold text-heading">Хронологія життя</h2>
        <dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface">
          {d.timeline.map((t) => (
            <div class="grid gap-1 px-4 py-2.5 sm:grid-cols-[6rem_1fr] sm:gap-4">
              <dt class="font-sans text-sm font-bold text-brand">{t.year}</dt>
              <dd class="text-[0.98rem] leading-relaxed">{t.event}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {works.length > 0 && (
      <section class="my-8">
        <h2 class="mb-3 font-sans text-2xl font-bold text-heading">Твори у програмі</h2>
        <ul class="space-y-2">
          {works.map((w) => (
            <li>
              <a href={`/tvory/${w.id}/`} class="group flex items-baseline justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3 transition hover:border-brand/60">
                <span class="font-sans text-[0.98rem] font-semibold text-heading group-hover:text-brand">{w.data.title}</span>
                <span class="shrink-0 font-sans text-xs text-muted">{w.data.classes.join(', ')} клас</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.quotes.length > 0 && <QuoteList quotes={d.quotes} title="Крилаті вислови" />}
  </div>
</Base>
