---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Callout from '../../components/Callout.astro';
import EssayVariants from '../../components/EssayVariants.astro';
import QuoteList from '../../components/QuoteList.astro';
import Tag from '../../components/Tag.astro';
import { getEssays, getWorks } from '../../lib/content';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const d = essay.data;
const { Content } = await render(essay);
const workExists = (await getWorks()).some((w) => w.id === d.workSlug);

const title = `Твір на тему «${d.title}» — ${d.variants.length} варіанти`;
const description = d.description ?? `${d.thesis} Готові твори за ${d.workTitle}${d.author ? ` (${d.author})` : ''} з планом і цитатами.`;
---

<Base {title} {description} type="article">
  <div class="mx-auto max-w-reading px-4 py-8">
    <Breadcrumbs items={[
      { label: `${d.classes[0]} клас`, href: `/${d.classes[0]}-klas/` },
      ...(workExists ? [{ label: d.workTitle, href: `/tvory/${d.workSlug}/` }] : [{ label: d.workTitle }]),
      { label: 'Твір' },
    ]} />

    <p class="font-sans text-sm text-muted">Твір за твором «{d.workTitle}»{d.author ? `, ${d.author}` : ''}</p>
    <h1 class="mt-1 font-sans text-3xl font-extrabold leading-tight tracking-tight text-heading sm:text-4xl">{d.title}</h1>

    <div class="mt-3 flex flex-wrap gap-1.5">
      {d.classes.map((k) => <Tag tone="ink" href={`/${k}-klas/`}>{k} клас</Tag>)}
      <Tag tone="brand">{d.variants.length} варіанти</Tag>
    </div>

    <Callout tone="key" title="Головна думка" icon="🎯">{d.thesis}</Callout>

    {d.plan.length > 0 && (
      <section class="my-6">
        <h2 class="mb-3 font-sans text-2xl font-bold text-heading">План</h2>
        <ol class="list-decimal space-y-1.5 rounded-xl border border-line bg-surface py-4 pl-9 pr-4 text-[0.98rem]">
          {d.plan.map((p) => <li>{p}</li>)}
        </ol>
      </section>
    )}

    <div class="prose-reading my-6"><Content /></div>

    <EssayVariants variants={d.variants} />

    {d.quotes.length > 0 && (
      <div class="mt-10"><QuoteList quotes={d.quotes} id="tsytaty" title="Цитати, які варто вставити" /></div>
    )}

    <Callout tone="warn" title="Перед тим як здавати">
      Не переписуй варіант слово в слово: учителі теж уміють гуглити, а однакові твори в одному класі помітно з першого рядка. Візьми структуру й аргументи, а приклади та фінальний висновок сформулюй своїми словами — це і оцінку підніме, і питань не викличе.
    </Callout>

    {workExists && (
      <p class="mt-8 font-sans text-sm">
        <a href={`/tvory/${d.workSlug}/`} class="text-brand hover:underline">← Короткий зміст і аналіз твору «{d.workTitle}»</a>
      </p>
    )}
  </div>
</Base>
